(ns dda.pages.source
  (:require
   [reagent.core :as r]
   ["@monaco-editor/react" :default MonacoEditor]
   [dda.utils.css :refer [css]]
   [dda.comp.organism.repl :as repl]))

(defn editor []
  [:> MonacoEditor
   {:language "clojure"
    :value    ";; some comment"
    :options  {:minimap  {:enabled false}
               :renderLineHighlight "none"
               :tabSize 2
               :guides {:indentation false}}
    :theme    "vs-dark"}])

(defn source-page []
  [:div (css "flex" "flex-row"
             "h-full" "w-full")
   ;; Editor
   [:div (css "flex-1")
    [editor]]
   ;; REPL
   [:div (css "flex-1")
    [repl/view]]])
